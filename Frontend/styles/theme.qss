/* ═══════════════════════════════════════════════════════════════
   Jarvis AI – Premium Gradient Theme
   Deep indigo → violet → teal with glassmorphic overlays
   ═══════════════════════════════════════════════════════════════ */

QWidget {
    background: transparent;
    color: #F4F7FA;
    font-family: "Inter", "Segoe UI", sans-serif;
}

/* ── Main Window: Multi-stop diagonal gradient ── */
#main-window {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0.00 #0c0118,
        stop:0.25 #1a0533,
        stop:0.50 #120e30,
        stop:0.75 #0d2b45,
        stop:1.00 #0a2a2e);
    border: 1px solid rgba(168, 85, 247, 0.15);
    border-radius: 22px;
}

/* ── Title Bar ── */
#titlebar {
    background: rgba(12, 8, 28, 0.65);
    border: 1px solid rgba(168, 85, 247, 0.12);
    border-radius: 18px;
}

#title-icon {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #a855f7, stop:1 #2dd4bf);
    color: #ffffff;
    font-weight: 800;
    font-size: 11px;
    text-align: center;
}

#title-name {
    color: #e2d9f3;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

#title-button {
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.18);
    border-radius: 12px;
    min-width: 30px;
    min-height: 24px;
    color: #d4c6f0;
    font-size: 14px;
}

#title-button:hover {
    background: rgba(168, 85, 247, 0.18);
    border-color: rgba(168, 85, 247, 0.35);
}

#title-button-close {
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.28);
    border-radius: 12px;
    min-width: 30px;
    min-height: 24px;
    color: #fda4af;
    font-size: 14px;
}

#title-button-close:hover {
    background: rgba(244, 63, 94, 0.30);
    border-color: rgba(244, 63, 94, 0.50);
}

#sidebar-toggle {
    background: rgba(168, 85, 247, 0.10);
    border: 1px solid rgba(168, 85, 247, 0.20);
    border-radius: 12px;
    min-width: 30px;
    min-height: 24px;
    color: #c4b5fd;
    font-size: 16px;
    font-weight: 700;
}

#sidebar-toggle:hover {
    background: rgba(168, 85, 247, 0.22);
}

/* ── Hero Section ── */
#hero {
    min-height: 200px;
}

#hero-aura {
    min-height: 160px;
    border-radius: 160px;
    opacity: 0.45;
}

#app-wordmark {
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-size: 56px;
    font-weight: 700;
    letter-spacing: -0.06em;
    color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #c084fc, stop:0.5 #e0c3fc, stop:1 #67e8f9);
    margin-top: -80px;
}

#hero-subtitle {
    color: #b8a9d4;
    font-size: 14px;
    letter-spacing: 0.03em;
}

#hero-tagline {
    color: #c4b5fd;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-top: -4px;
}

/* ── Input Bar ── */
#input-bar {
    background: rgba(18, 14, 48, 0.55);
    border: 1px solid rgba(168, 85, 247, 0.20);
    border-radius: 999px;
    min-height: 60px;
}

#input-bar:focus-within {
    border-color: rgba(168, 85, 247, 0.45);
}

#assistant-input {
    background: transparent;
    border: none;
    color: #F4F7FA;
    font-size: 15px;
    padding: 0 12px;
    selection-background-color: rgba(168, 85, 247, 0.35);
}

#assistant-input::placeholder {
    color: #8878a9;
}

#mic-button {
    background: rgba(168, 85, 247, 0.10);
    border: 1px solid rgba(168, 85, 247, 0.22);
    border-radius: 20px;
    color: #d4bffc;
    font-size: 18px;
}

#mic-button:hover {
    background: rgba(168, 85, 247, 0.22);
}

#send-button {
    border-radius: 999px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #a855f7, stop:1 #2dd4bf);
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    border: none;
}

#send-button:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #c084fc, stop:1 #5eead4);
}

/* ── Quick Action Cards ── */
#quick-card {
    background: rgba(18, 14, 48, 0.40);
    border: 1px solid rgba(168, 85, 247, 0.14);
    border-radius: 18px;
    min-height: 120px;
}

#quick-card:hover {
    background: rgba(26, 20, 58, 0.55);
    border-color: rgba(168, 85, 247, 0.30);
}

#quick-card-title {
    font-size: 18px;
    font-weight: 600;
    color: #ede9fe;
}

#quick-card-desc {
    color: #a78bdb;
    font-size: 13px;
    line-height: 1.4;
}

/* Card accent stripes — set per-card via dynamic properties */
#quick-card-accent-violet {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a855f7, stop:1 rgba(168, 85, 247, 0.0));
    min-height: 3px;
    max-height: 3px;
    border-radius: 2px;
}

#quick-card-accent-teal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2dd4bf, stop:1 rgba(45, 212, 191, 0.0));
    min-height: 3px;
    max-height: 3px;
    border-radius: 2px;
}

#quick-card-accent-amber {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #f59e0b, stop:1 rgba(245, 158, 11, 0.0));
    min-height: 3px;
    max-height: 3px;
    border-radius: 2px;
}

#quick-run {
    background: rgba(168, 85, 247, 0.10);
    border: 1px solid rgba(168, 85, 247, 0.22);
    border-radius: 999px;
    padding: 8px 16px;
    color: #d4bffc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

#quick-run:hover {
    background: rgba(168, 85, 247, 0.22);
    color: #ede9fe;
}

/* ── Response Panel ── */
#response-panel {
    background: rgba(14, 10, 40, 0.55);
    border: 1px solid rgba(168, 85, 247, 0.16);
    border-radius: 20px;
    min-height: 100px;
}

#user-query {
    color: #a78bdb;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
}

#assistant-answer {
    color: #F4F7FA;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.55;
}

#copy-button {
    background: rgba(168, 85, 247, 0.10);
    border: 1px solid rgba(168, 85, 247, 0.22);
    border-radius: 12px;
    min-height: 28px;
    max-width: 80px;
    color: #c4b5fd;
    font-size: 12px;
}

#copy-button:hover {
    background: rgba(168, 85, 247, 0.22);
}

/* ── Chat History Sidebar ── */
#chat-sidebar {
    background: rgba(14, 10, 30, 0.82);
    border: 1px solid rgba(168, 85, 247, 0.14);
    border-radius: 20px;
    min-width: 280px;
    max-width: 320px;
}

#sidebar-header {
    color: #ede9fe;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 0;
}

#sidebar-new-chat {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(168, 85, 247, 0.22), stop:1 rgba(45, 212, 191, 0.15));
    border: 1px solid rgba(168, 85, 247, 0.28);
    border-radius: 12px;
    padding: 9px 16px;
    color: #e0d4fc;
    font-weight: 600;
    font-size: 13px;
}

#sidebar-new-chat:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(168, 85, 247, 0.35), stop:1 rgba(45, 212, 191, 0.25));
}

#sidebar-clear {
    background: rgba(244, 63, 94, 0.10);
    border: 1px solid rgba(244, 63, 94, 0.22);
    border-radius: 10px;
    padding: 6px 12px;
    color: #fda4af;
    font-size: 11px;
    font-weight: 600;
}

#sidebar-clear:hover {
    background: rgba(244, 63, 94, 0.25);
}

#sidebar-scroll-area {
    background: transparent;
    border: none;
}

#sidebar-scroll-content {
    background: transparent;
}

#history-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(168, 85, 247, 0.08);
    border-radius: 14px;
    padding: 10px 14px;
}

#history-item:hover {
    background: rgba(168, 85, 247, 0.10);
    border-color: rgba(168, 85, 247, 0.25);
}

#history-role-icon {
    font-size: 16px;
    min-width: 24px;
    max-width: 24px;
}

#history-message-text {
    color: #d4c6f0;
    font-size: 12px;
    line-height: 1.3;
}

#history-timestamp {
    color: #7c6b9e;
    font-size: 10px;
    font-weight: 500;
}

#sidebar-empty-label {
    color: #7c6b9e;
    font-size: 13px;
    font-style: italic;
    padding: 20px 0;
}

/* ── Scrollbar ── */
QScrollBar:vertical {
    border: none;
    background: rgba(14, 10, 30, 0.5);
    width: 8px;
    margin: 4px 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a855f7, stop:1 #7c3aed);
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #c084fc, stop:1 #a855f7);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* ── Waveform accent ── */
#waveform-bar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #a855f7, stop:1 #2dd4bf);
}
